# UTF-8，无 BOM。此模板用于 Docker 部署；复制为 .env 后通常无需修改。
# 必须与 API、Collector 使用同一个生产 Docker 网络。
DEPLOY_NETWORK=saveb-production
# Nginx 容器内部仍监听 80；同事内网访问时将 ADMIN_BIND_IP 改成服务器内网 IP。
# 本地保留 127.0.0.1；本次服务器填 192.168.11.84。
ADMIN_BIND_IP=127.0.0.1
ADMIN_PORT=13000
# 本地 npm 开发服务不读取上述 Docker 配置：默认端口 3000，/api 代理见 vite.config.ts。
# 生产 /api 由根目录 nginx.conf 转发到 saveb-api-web:8080，无需填写 VITE_API_URL。
